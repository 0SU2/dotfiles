@import "colors.rasi"

configuration {
    show-icons: false;
    font: "Iosevka SS01 12";
}

window {
    location: center;
    anchor: center;
    height: 135px;
    width: 540px;
    y-offset: 880px;
    enabled: true;
    padding: 15px;
    background-color: @background;
}

mainbox {
    enabled: true;
    spacing: 15px;
    border: 2px solid;
    border-radius: 0px;
    border-color: @border;
    background-color: @background;
    children: [ "listview" ];
}

listview {
    enabled: true;
    cycle: true;
    dynamic: true;
    layout: horizontal;
    margin: 15.5px;
    border-color: @border;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
    spacing: 0.6em;
}

element {
    height: 100px;
    width: 150px;
    enabled: true;
    padding: 1.2em;
    background-color: @background-norm;
    text-color: @foreground;
}

element-text {
    background-color: transparent;
    text-color: @foreground;
    cursor: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element selected.normal {
    background-color: @background-alt;
    text-color: @foreground;
}

