#!/bin/bash

export DISPLAY=:0
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"

WARNING_LEVEL=25
BATTERY_DISCHARGING=`acpi -b | awk -e 'NR % 2 == 1 { print $0 }' | grep -c "Discharging"`
BATTERY_LEVEL=`acpi -b | awk -e 'NR % 2 == 1 { print $4 }' | grep -P -o '[0-9]+(?=%)'`

#  Use how files to store wheter we've show a notification or not (to prevent multiple notifications)
EMPTY_FILE=/tmp/batteryempty
FULL_FILE=/tmp/batteryfull
echo $BATTERY_DISCHARGING

if [ "$BATTERY_DISCHARGING" -eq 1 ] && [ -f $FULL_FILE ]; then
    rm $FULL_FILE
elif [ "$BATTERY_DISCHARGING" -eq 0 ] && [ -f $EMPTY_FILE ]; then
    rm $EMPTY_FILE
fi

# if the battery is charging and is full (and has not shown notification yet)
if [ "$BATTERY_LEVEL" -gt 97 ] && [ "$BATTERY_DISCHARGING" -eq 0 ] && [ ! -f $FULL_FILE ]; then
    notify-send "Battery Charged" "Battery is fully charged." -r 9991
    touch $FULL_FILE
# if th battery is low and is not charging (and has not show notification yet)
elif [ "$BATTERY_LEVEL" -le $WARNING_LEVEL ] && [ "$BATTERY_DISCHARGING" -eq 1 ] && [ ! -f $EMPTY_FILE ]; then
    notify-send "Low Battery" "${BATTERY_LEVEL}% of battery remainig" -u critical
    touch $EMPTY_FILE
fi
